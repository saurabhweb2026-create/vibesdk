/**
 * Monkeytrooprs v2 (test copy). Trimmed from the stock VibeSDK config:
 * no containers, no Workers for Platforms dispatcher, no Artifacts binding.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "monkeytrooprs-v2",
	"main": "worker/index.ts",
	"alias": {
		"artifacts-viewer": "./packages/artifacts-viewer/packages/artifacts-viewer/src/index.ts",
		"artifacts-viewer/server/cache": "./packages/artifacts-viewer/packages/artifacts-viewer/src/server/cache-adapters.ts"
	},
	"compatibility_date": "2026-05-23",
	"compatibility_flags": ["nodejs_compat"],
	"keep_vars": true,
	"rules": [
		{ "type": "Text", "globs": ["**/*.md", "**/*.md?raw"], "fallthrough": true }
	],
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": true,
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	},
	"unsafe": {
		"bindings": [
			{
				"name": "API_RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "2101",
				"simple": { "limit": 10000, "period": 60 }
			},
			{
				"name": "AUTH_RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "2102",
				"simple": { "limit": 1000, "period": 60 }
			}
		]
	},
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"browser": {
		"binding": "BROWSER",
		"remote": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "monkeytrooprs-v2-db",
			"database_id": "085a2c52-dff3-4a5a-aa00-b44bfc4784b3",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "CodeGeneratorAgent",
				"name": "CodeGenObject"
			},
			{
				"class_name": "DORateLimitStore",
				"name": "DORateLimitStore"
			},
			{
				"class_name": "UserSecretsStore",
				"name": "UserSecretsStore"
			},
			{
				"class_name": "ThinkAgent",
				"name": "THINK_DO"
			},
			{
				"class_name": "SpaceDO",
				"name": "SPACE_DO"
			}
		]
	},
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	"r2_buckets": [
		{
			"binding": "TEMPLATES_BUCKET",
			"bucket_name": "0code-templates"
		}
	],
	"kv_namespaces": [
		{
			"binding": "VibecoderStore",
			"id": "69959df754e24c9fbdb56d29431d0ca0"
		}
	],
	"migrations": [
		{
			"new_sqlite_classes": [
				"CodeGeneratorAgent",
				"UserAppSandboxService"
			],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": [
				"DORateLimitStore"
			],
			"tag": "v2"
		},
		{
			"new_sqlite_classes": [
				"UserSecretsStore"
			],
			"tag": "v3"
		},
		{
			"new_sqlite_classes": [
				"SpaceDO"
			],
			"tag": "v5"
		},
		{
			"new_sqlite_classes": [
				"ThinkAgent"
			],
			"tag": "v6"
		}
	],
	"vars": {
		"TEMPLATES_REPOSITORY": "https://github.com/cloudflare/vibesdk-templates",
		"CLOUDFLARE_ACCOUNT_ID": "d189e2100261fc9cdafc7fc8a337f6f6",
		"CLOUDFLARE_AI_GATEWAY": "vibesdk-gateway",
		"ENABLE_CLOUDFLARE_LIMITS": "true",
		"ENABLE_EMAIL_AUTH": "true",
		"PLATFORM_CAPABILITIES": {
			"features": {
				"app": {
					"enabled": true
				},
				"presentation": {
					"enabled": false
				},
				"general": {
					"enabled": false
				}
			},
			"version": "1.0.0"
		},
		"CUSTOM_DOMAIN": "monkeytrooprs-v2.saurabh-web2026.workers.dev",
		"MAX_SANDBOX_INSTANCES": "10",
		"SANDBOX_INSTANCE_TYPE": "standard-3",
		"DEV_BROWSER_SIDECAR_URL": "http://127.0.0.1:9223",
		"DEV_BROWSER_PREVIEW_ORIGIN": "http://localhost:5173"
	},
	"workers_dev": true,
	"preview_urls": false
}
